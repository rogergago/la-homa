{
  "name": "la-homa",
  "version": "5.0.0-beta.1",
  "private": true,
  "description": "La Homa - web familiar responsive",
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:site": "node site/build.cjs",
    "build:admin": "node admin/build.cjs",
    "build:public": "node site/build.cjs && node admin/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "python3 tests/web5-browser.py",
    "check": "npm run build && npm test",
    "dev": "npm run build && node scripts/serve.cjs"
  },
  "engines": {
    "node": ">=22"
  }
}
